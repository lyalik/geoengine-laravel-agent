{
    "name": "geoengine/agent",
    "description": "GEO Engine agent for Laravel — SEO meta, JSON-LD, llms.txt, catalog sync, managed redirects with rollback and self-update.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "GeoEngine\\Agent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GeoEngine\\Agent\\GeoEngineServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
